// Detect potential password spraying: one IP failing against many accounts.
// Signal: a single IP generating failures for 3+ distinct accounts in a 15-minute bin.
// Error codes: 50126 = invalid username or password; 50053 = account locked; 50034 = user not found.
// Table: SigninLogs (interactive) | Window: 24h
// Complements 04 (many attempts, one account). Distributed sprays across many IPs need a different aggregation.
SigninLogs
| where TimeGenerated >= ago(24h)
| where ResultType in ("50126", "50053", "50034")
| summarize
    FailedAttempts = count(),
    TargetedAccounts = dcount(UserPrincipalName),
    Users = make_set(UserPrincipalName, 20),
    FirstAttempt = min(TimeGenerated),
    LastAttempt = max(TimeGenerated)
    by IPAddress, bin(TimeGenerated, 15m)
| where TargetedAccounts >= 3
| project FirstAttempt,
          LastAttempt,
          IPAddress,
          FailedAttempts,
          TargetedAccounts,
          Users
| order by TargetedAccounts desc
