// TEMPLATE: successful interactive sign-ins for explicitly monitored accounts.
// Replace both sample GUIDs with actual Entra user Object IDs ONLY in your private alert rule.
// This is NOT automatic discovery of every Global Administrator.
let MonitoredUserIds = dynamic([
    "00000000-0000-0000-0000-000000000001",
    "00000000-0000-0000-0000-000000000002"
]);
SigninLogs
| where TimeGenerated > ago(15m)
| where ResultType == "0"
| where UserId in~ (MonitoredUserIds)
| project TimeGenerated, UserPrincipalName, UserId, IPAddress, AppDisplayName, ResultType
| order by TimeGenerated desc
